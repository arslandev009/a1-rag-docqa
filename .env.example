# Project-level settings (provider keys live in the workspace .env)
DATABASE_URL=postgresql://docqa:docqa_dev_password@127.0.0.1:55433/docqa
DB_SCHEMA=docqa
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
EMBED_BATCH_SIZE=32
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_SENTENCES=1

# retrieval and answering (A1.3 / A1.4)
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_KEYWORD_WEIGHT=0.25
ANSWER_K=5
ABSTAIN_MIN_COSINE=0.55
ANSWER_MAX_TOKENS=1500
ANSWER_TEMPERATURE=0        # set empty to omit the parameter (some reasoning models reject it)

# --- API (A1.6) ---
GATEWAY_SECRET=
API_ALLOWED_PROVIDERS=gemini,groq
API_DEFAULT_PROVIDER=gemini
API_RATE_LIMIT_PER_MIN=10
API_DAILY_LLM_CALLS=300
CORS_ORIGINS=
